# livebot environment variables
# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# Never commit the real .env file. It is already ignored by .gitignore.
#
# WARNING: goinglivenow.py creates every OKX client with flag="0" (LIVE trading).
# Orders placed with these keys use real money.

# --- OKX API credentials (required) ---
# Create the key in OKX > API with "Trade" permission.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# --- Trading settings (required) ---
# OKX instrument ID of the perpetual swap to trade
SYMBOL=AVAX-USDT-SWAP
# Order size in contracts
POS_SIZE=1

# --- Bot identity (optional, defaults to "default") ---
# Used for the state file name: /home/ubuntu/livebot/state_<BOT_NAME>.json
# Give each bot a different name if you run several on one machine.
BOT_NAME=avax

# --- Weekly PnL email (optional) ---
# If any of these three is missing, the bot keeps trading and skips the email.
SENDER_EMAIL=you@gmail.com
RECEIVER_EMAIL=you@gmail.com
# Gmail App Password for SENDER_EMAIL (not your normal Gmail password)
GMAIL_APP_PASSWORD=
